{
  "manifest_version": 3,
  "name": "Doc Form Filler",
  "version": "0.2.0",
  "description": "Pre-fills FMLA, MetroAccess and DC DDS forms from the Practice Fusion chart you have open. You review and sign.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fill a form for this patient",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.practicefusion.com/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.practicefusion.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "115",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Fill a form for the open patient chart"
    }
  }
}
